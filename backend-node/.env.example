# Desarrollo local contra Docker. No copiar aquí valores de Vercel ni de MonsterASP.
# Cargar con el entorno del proceso, no con argumentos que queden en el historial.
# Los archivos .env y .env.* están ignorados; este ejemplo sí se versiona.

APP_ORIGIN=http://localhost:4200
DATABASE_URL=mysql://goodlook_test:local_test_only_password@127.0.0.1:33317/goodlook_disposable_test
MYSQL_ALLOW_INSECURE_LOCAL=true
# 32 bytes hex aleatorios. El valor fijo de la demo local está solo en PILOTO.md
# y no sirve para preview: si se copia, el cupo queda predecible.
AUTH_LIMIT_SECRET=generate-64-hex-characters-before-use
GOODLOOK_DATA_ENV=development

# No definir VERCEL ni VERCEL_ENV. Vercel las inyecta en sus despliegues.
# VERCEL=1 fuera de Vercel haría que el limitador de la historia #18 confiara
# en x-vercel-forwarded-for. Sin papel declarado, una base remota no arranca.
# Las identidades están en config/production-database.json y
# config/preview-database.json. No son secretos.

# Preview remoto, solo en el entorno Preview de Vercel, nunca en este archivo:
#   GOODLOOK_DATA_ENV=preview
#   MYSQL_TLS=true
#   APP_ORIGIN=https://<alias-estable-de-la-rama>
#   DATABASE_URL=mysql://db81522:<contraseña>@db81522.public.databaseasp.net:3306/db81522
#   AUTH_LIMIT_SECRET=<otro secreto hex de al menos 32 bytes>
# El host, el nombre y el usuario tienen que ser los de preview-database.json.

# Migración de esa base de preview, desde un archivo local ignorado:
#   GOODLOOK_MIGRATION_TARGET=preview
#   GOODLOOK_MIGRATION_DIALECT=mariadb
#   MYSQL_TLS=true
#   DATABASE_URL=mysql://db81522:<contraseña>@db81522.public.databaseasp.net:3306/db81522

{
  "name": "goodlook-api",
  "version": "0.1.0",
  "description": "Base de la API GoodLook",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:openapi": "redocly lint openapi.yaml",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/server.js"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.24",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
